<?xml version="1.0"?>
<launch>

    <arg name="namespace_vision"   default="vision"/>
    <arg name="model_path"         default="yolo11m.pt"/>
    <arg name="image_topic"        default="/hardware/camera/image_raw"/>  <!--/hardware/camera/image_raw && /kinect/image_raw-->
    <arg name="pointcloud_topic"   default="/hardware/camera/points"/>  <!--/hardware/camera/points && /kinect/points--> 

    <node
      pkg="yolo_detect"
      exec="yolo_detect_node"
      name="yolo_detect_node"
      namespace="$(var namespace_vision)"
      output="screen">
        <param name="model_path"   value="$(var model_path)"/>
        <param name="image_topic"   value="$(var image_topic)"/>
    </node>

    <node
      pkg="vision_tools"
      exec="detect_seats_node"
      name="detect_seats_node"
      namespace="$(var namespace_vision)"
      output="screen">
    </node>

    <node
      pkg="vision_tools"
      exec="Detect_Fusion_Node"
      name="detect_fusion_node"
      namespace="$(var namespace_vision)"
      output="screen">
    </node>

    <node
      pkg="pc_bbox_pose"
      exec="pc_bbox_pose_node"
      name="pc_bbox_pose_node"
      namespace="$(var namespace_vision)"
      output="screen">
        <param name="cloud_topic"   value="$(var pointcloud_topic)"/>
    </node>

    <node
      pkg="face_recog"
      exec="faceFlorence"
      name="face_recog_node"
      namespace="$(var namespace_vision)"
      output="screen">
      <param name="image_topic" value="$(var image_topic)"/>
    </node>

    <node
      pkg="owlv2_detect"
      exec="owlv2_node"
      name="owlv2_detect_node"
      namespace="$(var namespace_vision)"
      output="screen">
      <param name="image_topic" value="$(var image_topic)"/>
      <param name="pointcloud_topic" value="$(var pointcloud_topic)"/>
    </node>

    <node
      pkg="owlv2_detect"
      exec="Analize_node"
      name="Analize_cat_node"
      namespace="$(var namespace_vision)"
      output="screen">
    </node>

    <node
      pkg="human_detection"
      exec="pose_detector"
      name="pose_detector_node"
      namespace="$(var namespace_vision)"
      output="screen">
        <param name="image_topic"   value="$(var image_topic)"/>
        <param name="pointcloud_topic" value="$(var pointcloud_topic)"/>
    </node>


    <node
      pkg="table_alignment"
      exec="table_segmenter_node"
      name="table_segmenter_node"
      namespace="$(var namespace_vision)"
      output="screen">
        <param name="pointcloud_topic" value="$(var pointcloud_topic)"/>
    </node>

    <node
      pkg="vacancy_detector"
      exec="table_drop_tf_node"
      name="table_drop_tf_node"
      namespace="$(var namespace_vision)"
      output="screen">
        <param name="pointcloud_topic" value="$(var pointcloud_topic)"/>
        <param name="fixed_frame_id" value="map"/>
        <param name="validation_frame_id" value="base_link"/>
        <param name="table_frame_id" value="table_frame"/>
        <param name="drop_start_frame_id" value="table_drop_start"/>
        <param name="drop_points_file" value="src/Vision/vacancy_detector/src/table_drop_points.txt"/>
        <param name="active_on_start" value="false"/>
    </node>

    <node
      pkg="vacancy_detector"
      exec="container_drop_tf_node"
      name="container_drop_tf_node"
      namespace="$(var namespace_vision)"
      output="screen">
        <param name="pointcloud_topic" value="$(var pointcloud_topic)"/>
        <param name="fixed_frame_id" value="base_link"/>
        <param name="validation_frame_id" value="base_link"/>
        <param name="container_frame_id" value="container_frame"/>
        <param name="drop_start_frame_id" value="container_drop_start"/>
        <param name="drop_points_file" value="src/Vision/vacancy_detector/src/container_drop_points.txt"/>
        <param name="container_min_width_m" value="0.12"/>
        <param name="container_min_depth_m" value="0.07"/>
        <param name="object_min_height_m" value="0.25"/>
        <param name="object_max_height_m" value="0.55"/>
        <param name="safe_abs_y_max_m" value="0.42"/>
        <param name="safe_z_max_m" value="1.10"/>
        <param name="start_clearance_m" value="0.0"/>
        <param name="drop_x_offset_m" value="0.08"/>
        <param name="drop_y_offset_m" value="0.0"/>
        <param name="override_drop_y" value="true"/>
        <param name="drop_y_override_m" value="0.0"/>
        <param name="cluster_tolerance_m" value="0.065"/>
        <param name="min_wall_coverage" value="0.25"/>
        <param name="max_interior_fill_ratio" value="1.05"/>
        <param name="active_on_start" value="false"/>
    </node>

    <node
      pkg="vacancy_detector"
      exec="shelf_drop_tf_node"
      name="shelf_drop_tf_node"
      namespace="$(var namespace_vision)"
      output="screen">
        <param name="pointcloud_topic" value="$(var pointcloud_topic)"/>
        <param name="fixed_frame_id" value="map"/>
        <param name="validation_frame_id" value="base_link"/>
        <param name="shelf_frame_id" value="shelf_frame"/>
        <param name="drop_start_frame_id" value="shelf_drop_start"/>
        <param name="drop_points_file" value="src/Vision/vacancy_detector/src/shelf_drop_points.txt"/>
        <param name="active_on_start" value="false"/>
    </node>

<!--
    <node
      pkg="vision_tools"
      exec="image_fixed_node"
      name="image_fixed_node"
      namespace="$(var namespace_vision)"
      output="screen">
    </node>
-->
</launch>
