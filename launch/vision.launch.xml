<?xml version="1.0"?>
<launch>

    <arg name="namespace_vision"   default="vision"/>
    <arg name="model_path"         default="yolo11m.pt"/>
    <arg name="image_topic"        default="/head_rgbd_sensor/rgb/image_rect_color"/>
    <arg name="pointcloud_topic"   default="/hardware/camera/points"/>

    <node
      pkg="yolo_detect"
      exec="yolo_detect_node"
      name="yolo_detect_node"
      namespace="$(var namespace_vision)"
      output="screen">
        <param name="model_path"   value="$(var model_path)"/>
        <param name="image_topic"   value="$(var image_topic)"/>
    </node>



    <node
      pkg="vision_tools"
      exec="detect_seats_node"
      name="detect_seats_node"
      namespace="$(var namespace_vision)"
      output="screen">
    </node>


    <node
      pkg="vision_tools"
      exec="detect_objects_node"
      name="detect_objects_node"
      namespace="$(var namespace_vision)"
      output="screen">
    </node>

    <node
      pkg="pc_bbox_pose"
      exec="pc_bbox_pose_node"
      name="pc_bbox_pose_node"
      namespace="$(var namespace_vision)"
      output="screen">
        <param name="cloud_topic"   value="$(var pointcloud_topic)"/>
    </node>

    <node
      pkg="face_recog"
      exec="faceFlorence"
      name="face_recog_node"
      namespace="$(var namespace_vision)"
      output="screen">
      <param name="image_topic" value="$(var image_topic)"/>
    </node>

</launch>